---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { fmtDate } from "../lib";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base>
  <section class="intro">
    <p>
      I make maps, write things, and work at Mapbox. Formerly a filmmaker,
      photographer, baker, and wilderness first responder.
    </p>
  </section>

  <section>
    <h2>Things</h2>
    <ul class="things">
      <li>
        <a href="/maps/etymapology">Etymapology</a>{" "}
        <span>— a map that traces a word back through time and place.</span>
      </li>
      <li>
        <a href="/human-idiot">Human Idiot</a>{" "}
        <span>— a collection of rambles. Poems and photographs, as a book you can pick up.</span>
      </li>
    </ul>
  </section>

  {posts.length > 0 && (
    <section>
      <h2>Writing</h2>
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>
              {fmtDate(post.data.date)}
            </time>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      <p><a href="/blog">all writing →</a></p>
    </section>
  )}
</Base>
