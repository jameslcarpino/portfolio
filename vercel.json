{
  "framework": "astro",
  "redirects": [
    {
      "source": "/human-idiot",
      "destination": "/human-idiot/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/human-idiot/",
      "destination": "https://human-idiot.vercel.app/"
    },
    {
      "source": "/human-idiot/:path*",
      "destination": "https://human-idiot.vercel.app/:path*"
    },
    {
      "source": "/maps/etymapology",
      "destination": "https://etymapology.vercel.app/maps/etymapology"
    },
    {
      "source": "/maps/etymapology/:path*",
      "destination": "https://etymapology.vercel.app/maps/etymapology/:path*"
    }
  ]
}
